&backlight {
        pwms = <&pwm1 0 25000 0>;
        status = "disable";
};

&pwm1 {
        status = "disable";
};

&route_dsi0 {
        status = "okay";
        connect = <&vp2_out_dsi0>;
};

/*
 * mipi_dcphy0 needs to be enabled
 * when dsi0 is enabled
 */
&dsi0_in_vp2 {
        status = "okay";
};

&dsi0_in_vp3 {
        status = "disabled";
};



&mipi_dcphy0 {
	status = "okay";
};

&dsi0 {
        status = "okay";
        //rockchip,lane-rate = <1000>;
        dsi0_panel: panel@0 {
                status = "okay";
                compatible = "simple-panel-dsi";
                power-supply = <&vcc3v3_lcd_n>;
                reg = <0>;
               // backlight = <&backlight>;
                reset-delay-ms = <10>;
                enable-delay-ms = <35>;
                prepare-delay-ms = <6>;
                unprepare-delay-ms = <0>;
                disable-delay-ms = <20>;
                dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
                        MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_EOT_PACKET)>;
                dsi,format = <MIPI_DSI_FMT_RGB888>;
                dsi,lanes  = <4>;
		dsi,channel = <0>;
		size,width = <120>;
	        size,height = <170>;
                
                panel-init-sequence = [
			29 00 02 27 AA
                        29 00 02 48 02
                        29 00 02 B6 20
                        29 00 02 01 80
                        29 00 02 02 38
                        29 00 02 03 47
                        29 00 02 04 8C
                        29 00 02 05 0A
                        29 00 02 06 82
                        29 00 02 07 00
                        29 00 02 08 14
                        29 00 02 09 0A
                        29 00 02 0A 0F
                        29 00 02 0B 02
                        29 00 02 0C 52
                        29 00 02 0D 01
                        29 00 02 0E 80
                        29 00 02 0F 20
                        29 00 02 10 20
                        29 00 02 11 03
                        29 00 02 12 1B
                        29 00 02 13 63
                        29 00 02 14 01
                        29 00 02 15 23
                        29 00 02 16 40
                        29 00 02 17 00
                        29 00 02 18 01
                        29 00 02 19 23
                        29 00 02 1A 40
                        29 00 02 1B 00
                        29 00 02 1E 46
                        29 00 02 51 30
                        29 00 02 1F 10
                        29 00 02 2A 01


			05 C8 01 11
			05 14 01 29
                ];
                panel-exit-sequence = [

                ];

                disp_timings0: display-timings {
                        native-mode = <&dsi0_timing0>;
                        dsi0_timing0: timing0 {
                                clock-frequency = <148500000>; //<60000000>;//71900000
                                hactive = <1920>; //<800>;
                                vactive = <1080>; //<1280>;
                                hfront-porch = <140>; //<80>;//20
                                hsync-len = <10>; //<20>;
                                hback-porch = <130>;//20
                                vfront-porch = <20>; //<20>;//10
                                vsync-len = <10>;
                                vback-porch = <15>; //<12>;//4
                                hsync-active = <0>;
                                vsync-active = <0>;
                                de-active = <0>;
                                pixelclk-active = <0>;
                        };
                };


#if 0
              panel-init-sequence = [
			23 00 02 27 AA
                        23 00 02 48 02
                        23 00 02 B6 20
                        23 00 02 01 80
