                disp_timings0: display-timings {
                        native-mode = <&dsi0_timing0>;
                        dsi0_timing0: timing0 {
                                clock-frequency = <136300000>; //<60000000>;//71900000
                                hactive = <1920>; //<800>;
                                vactive = <1080>; //<1280>;
                                hfront-porch = <6>; //<80>;//20
                                hsync-len = <4>; //<20>;
                                hback-porch = <80>;//20
